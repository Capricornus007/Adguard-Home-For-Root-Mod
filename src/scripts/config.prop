#注：以下所有开关项修改后必须重启生效
# AdGuardHome 运行用户和用户组（adg_group 已不再参与劫持豁免匹配，保留仅为兼容旧配置：
# chown root:net_raw 改的是文件所属组，不改变进程的有效 gid，服务由 root 启动时 egid=0）
adg_user="root"
adg_group="net_raw"

# AdGuardHome DNS 重定向端口
redir_port=5591

# 劫持豁免的目的地址列表（空格分隔）
# 这些地址＝「AGH 自己当上游用的 DNS 服务器」。写在这里的意思是：发往它们的 53 端口
# 流量直接放行、不再被 REDIRECT 回 AGH 自己的监听端口。不写会怎样：AGH 查上游等于问自己，
# 自己再问自己，形成自我劫持死锁，表现为整个手机 DNS 无应答（DoH 上游一断就全线卡死）。
# 填入 VPN 的 tun DNS 地址（如 172.19.0.2）可讓 fake-ip 模式繼續工作
# 默認劫持一切＝其餘所有 DNS 都經 AGH 過濾（去廣告效果最完整）
# 下面這組預設值對應本模組內建 AdGuardHome.yaml 的 bootstrap_dns／建議的 fallback_dns，
# 換了上游伺服器就要同步改這裡，否則新上游的 53 端口查詢又會被劫持回來。
ignore_dest_list="180.184.1.1 180.184.2.2 8.8.8.8 119.29.29.29 223.5.5.5 1.1.1.1"

# 代理订阅链接（在引号内填入你的订阅）
PROXY_URL=" "

# ---- 上游健康探測（scripts/healthcheck.sh）----
# 為什麼需要：AGH「進程活著」不等於「能用」。上游全啞時命中黑名單的查詢照樣秒回，
# 只有需要走上游的查詢會掛滿 upstream_timeout 才失敗（連 query log 都不寫），
# 表現在用戶那裡就是「代理 App 連得上卻沒流量」。這支腳本用隨機子域去問 AGH，
# 連續失敗就重啟 AGH（只重啟，絕不碰飛行模式）。以下參數不寫就用腳本內預設值。
# probe_wait=20       # 單次探測等回覆的硬上限秒數（要 > yaml 的 upstream_timeout，否則慢但真的回覆會被誤判）
# probe_attempts=3    # 一輪探測連發幾個隨機名稱（任一有答即算這一輪健康）
# attempt_gap=3       # 同一輪內兩次嘗試之間的小間隔秒數
# probe_interval=60   # 健康時每隔幾秒問一次
# retry_gap=45        # 已經判失敗後，下一次探測隔幾秒（連錯才動作，避免單次抖動）
# fail_threshold=3    # 連續失敗幾次才重啟 AGH
# max_restart=2       # 一個故障週期最多重啟幾次，超過就停止空轉並發通知
# start_delay=90      # 開機後隔多久才開始判定（等網路就緒）
# ---- 投毒判定（誠實性檢查）----
# 「有回覆」不等於「回覆誠實」：境內在途注入會秒回假 IP（實測 157.240.7.20、185.45.5.35）。
# 這種情況重啟 AGH 沒用（鍋在鏈路／上游），腳本只記日誌＋發一次通知、絕不重啟。
# 做法是順帶問一次 dns.google（誠實上游必回 8.8.8.8/8.8.4.4），答案不對就記一筆可疑。
# poison_check=1        # 設 0 關掉投毒判定（存活探測與重啟邏輯不受影響）
# poison_check_aaaa=1   # 設 0 單關 IPv6(AAAA) 判定、保留 v4。預設開：用戶在意 v6，境內上游會回
#                       # 假 v6（實測形態 2001::1），假 v6 要能定罪；而投毒分支本就不重啟，加它零風險。
#                       # 注意「拿不到 AAAA」不等於投毒（很多上游沒 v6／鏈路無 v6），一律判無法判定、不定罪。
# poison_wait=5         # 誠實性檢查等回覆秒數；超時只算「無法判定」，不會據此定罪
# poison_threshold=2    # 累計幾輪假回覆才報投毒（單發可疑不驚呼，要兩次獨立證據）
# 另：dns.google 若被「本地過濾規則」自己攔掉（回 0.0.0.0 或完全查不到 A 記錄），投毒判定會
# 無效且過去完全靜默——現已在 agh.log 留一行 HC_BLOCKED_HINT 並發一次性通知提醒你查規則
# （同一場攔截只提醒一次，不會每輪刷屏）。這不需要额外開關，是常開的行為。
